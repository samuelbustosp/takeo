# ==============================================================================
# TAKEO Environment Variables Template
# ==============================================================================

# Supabase Configuration
# Si estas variables están vacías o son placeholders, la app funciona en modo MOCK automático.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / WhatsApp Business Cloud API
# Puedes configurarlas aquí o directamente desde el Dashboard en /dashboard/settings
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
